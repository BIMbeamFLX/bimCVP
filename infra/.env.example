# Bundle-level config (used by deploy-site.sh). Copy to .env on the server.
# No secrets here — LNbits secrets live in lnbits/.env only.

# Public web repo that contains the static site under site/
SITE_REPO_URL=https://github.com/<your-user>/<your-repo>.git
SITE_REPO_BRANCH=main

# Primary domain (informational; Caddyfile has it hard-wired)
PRIMARY_DOMAIN=gemeinwert.com
