# LNbits — BIM CVP pilot  (wallet engine only, STOCK, no fork)
# Served at https://pay.bimcvp.com ; serves NIP-05 for name@bimcvp.com
# Copy to lnbits/.env on the server, fill, then:  chmod 600 lnbits/.env
# Real .env is NEVER committed anywhere.

# --- Wallet backend ----------------------------------------------------------
# Bring the box up with FakeWallet (no real sats). Swap to phoenixd in Phase 2
# (uncomment the phoenixd service in docker-compose.yml, then set:
#   LNBITS_BACKEND_WALLET_CLASS=PhoenixdWallet
#   PHOENIXD_API_ENDPOINT=http://phoenixd:9740
#   PHOENIXD_API_PASSWORD=<from phoenixd>            )
LNBITS_BACKEND_WALLET_CLASS=FakeWallet
FAKE_WALLET_SECRET=CHANGE-ME-long-random-string

# --- UI ----------------------------------------------------------------------
# NOTE: docker env_file does NOT strip quotes — do not quote values here.
LNBITS_SITE_TITLE=BIM CVP
LNBITS_SITE_TAGLINE=Pilot wallet and identity
LNBITS_DENOMINATION=sats
LNBITS_DEFAULT_THEME=monochrome
LNBITS_AD_SPACE_ENABLED=false

# --- Database (SQLite is fine for the pilot) ---------------------------------
# LNbits builds the SQLite DB inside LNBITS_DATA_FOLDER. Do NOT set
# LNBITS_DATABASE_URL for SQLite: "sqlite:///app/data/..." (3 slashes) is a
# RELATIVE path -> resolves to /app/app/data -> "unable to open database file".
# LNBITS_DATABASE_URL is for Postgres/CockroachDB only.
LNBITS_DATA_FOLDER=/app/data

# --- Extensions --------------------------------------------------------------
# Only what the pilot needs. Anything not listed stays inert (no fork to strip).
#   usermanager : account/wallet provisioning (the user registry)
#   nostrnwc    : NIP-47 Nostr Wallet Connect (per-user wallet)
#   lnurlp      : LNURL-pay / Lightning Address
#   nostrnip5   : serves NIP-05  name@gemeinwert.com
LNBITS_EXTENSIONS_DEFAULT_INSTALL=usermanager,nostrnwc,lnurlp,nostrnip5,invoices,satspay,splitpayments,cashu

# --- Network -----------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
# Caddy terminates TLS and forwards the real host/scheme:
FORWARDED_ALLOW_IPS=*
LNBITS_BASEURL=https://pay.bimcvp.com/

# --- Security ----------------------------------------------------------------
# Rate limit: NO must be a plain integer, UNIT separate. NOT "10/minute"
# (that builds an invalid "10/minute/minute" limit -> ValueError on every request).
LNBITS_RATE_LIMIT_NO=200
LNBITS_RATE_LIMIT_UNIT=minute
# Leave these COMMENTED OUT. An empty value (LNBITS_ALLOWED_USERS=) is parsed
# by LNbits as [''] -> generic ValueError on GET /. Set them (uncomment) only
# once you have real user ids, comma-separated.
#LNBITS_ADMIN_USERS=
#LNBITS_ALLOWED_USERS=
